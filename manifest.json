{
  "manifest_version": 3,
  "name": "Episode Ratings for AniList",
  "version": "1.0.1",
  "description": "Shows Series Graph's per-episode rating chart on AniList anime pages.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://seriesgraph.com/*",
    "https://graphql.anilist.co/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://anilist.co/*"
      ],
      "js": [
        "src/chart.js",
        "src/content.js"
      ],
      "css": [
        "src/styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
